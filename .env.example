# Form submissions are sent to Telegram. Copy this file to .env.local and fill in.
# Bot token: from @BotFather when you created the bot.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Chat id: send your bot a message, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and read result[0].message.chat.id  (negative for groups).
TELEGRAM_CHAT_ID=123456789
